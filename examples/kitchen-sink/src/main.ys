// A bigger tour of yarescript: functions, let/const, control flow, and
// every primitive type, all compiled straight to WebAssembly.
// Build it with `yare build`, run it with `yare run`.

public function: int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

public function: int sumTo(int n) {
    let: int total = 0;
    for (let: int i = 1; i <= n; i++) {
        total += i;
    }
    return total;
}

public function: bool isEven(int n) {
    return n % 2 == 0;
}

public function: double average(double a, double b) {
    const: double two = 2.0;
    return (a + b) / two;
}

// The narrow and unsigned widths, wrapping exactly where their width says
// they should. None of this is a trick: an i8 at 127 has one place to go.
public function: void wrapDemo() {
    let: i8 signed8 = 127;
    signed8++;
    let: u8 byte = 250;
    byte = byte + 10;
    let: u16 small = 65535;
    small++;
    let: u32 big = 4000000000;
    let: u64 huge = 0;
    huge = huge - 1;
    let: i16 half = 30000;
    half = half + 10000;
    console.println(signed8);
    console.println(byte);
    console.println(small);
    console.println(big > 1);
    console.println(huge);
    console.println(half);
}

// The syntax that makes a language feel familiar: a ternary, a switch that
// falls through on purpose, do..while, for..of, bitwise operators, template
// strings, and a type you can leave to the compiler.
public function: void syntaxDemo() {
    let n = 5;
    console.println(n > 3 ? "big" : "small");

    let: string word = "";
    switch (n) {
        case 1: {
            word = "one";
            break;
        }
        case 5: {
            word = "five";
        }
        case 6: {
            word = word + " or six";
            break;
        }
        default: {
            word = "other";
        }
    }
    console.println(word);

    let: int i = 0;
    do {
        i++;
    } while (i < 3);

    let: int total = 0;
    for (let: int x of [4, 5, 6]) {
        total += x;
    }
    console.println(total);

    let: string bits = "";
    for (let: char c of "abc") {
        bits += c;
    }
    console.println(bits);

    console.println(`n is ${n}, i is ${i}, half is ${1.5}, mask is ${6 & 3}`);
    console.println(typeof n);
}

public function: void main() {
    console.println("yarescript kitchen sink");
    wrapDemo();
    let: int fibResult = fib(10);
    console.println(fibResult);
    let: int total = sumTo(100);
    console.println(total);
    console.println(isEven(total));
    let: double avg = average(3.5, 4.5);
    console.println(avg);
    let: int counter = 0;
    while (counter < 5) {
        console.println(counter);
        counter = counter + 1;
    }
    syntaxDemo();
    console.println("done");
}
