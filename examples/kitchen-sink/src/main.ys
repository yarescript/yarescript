// A bigger tour of yarescript: functions, let/const, control flow, and
// every primitive type, all compiled straight to WebAssembly.
// Build it with `yare build`, run it with `yare run`.

public function: int fib(int n) {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

public function: int sumTo(int n) {
    let: int total = 0;
    for (let: int i = 1; i <= n; i++) {
        total += i;
    }
    return total;
}

public function: bool isEven(int n) {
    return n % 2 == 0;
}

public function: double average(double a, double b) {
    const: double two = 2.0;
    return (a + b) / two;
}

public function: void main() {
    console.log("yarescript kitchen sink");

    let: int fibResult = fib(10);
    console.log(fibResult);

    let: int total = sumTo(100);
    console.log(total);

    console.log(isEven(total));

    let: double avg = average(3.5, 4.5);
    console.log(avg);

    let: int counter = 0;
    while (counter < 5) {
        console.log(counter);
        counter = counter + 1;
    }

    console.log("done");
}
